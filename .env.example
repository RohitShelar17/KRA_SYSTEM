# Copy to .env and fill in. Nothing here has a working default on purpose:
# compose refuses to start rather than bringing the platform up with a
# credential that is written down in the repository.

# --- database -----------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=kra_system
DB_USERNAME=kra
DB_PASSWORD=

# --- application --------------------------------------------------------
# At least 32 characters. Generate one, do not think one up:
#   openssl rand -base64 48
JWT_SECRET=

# Encoded at first start for the bootstrap administrator, who is then forced
# to change it at first sign-in.
ADMIN_DEFAULT_PASSWORD=

# The SPA's own origin. The prod profile refuses to start if this still
# mentions localhost.
CORS_ALLOWED_ORIGINS=https://kra.example.com

# Where people reach this system in a browser. Notification links are stored
# as paths so they work inside the app; this is what completes them for an
# email, so a sign-in invite has somewhere to point.
APP_BASE_URL=https://kra.example.com

# --- email --------------------------------------------------------------
# Off by default. With it off, deliveries record SKIPPED with the reason and a
# sign-in invite has to be passed on by hand from the employee screen.
# Switching it on without MAIL_HOST records FAILED, which is also honest.
NOTIFICATIONS_EMAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@kra.example.com
MAIL_FROM_NAME=KRAPulse
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# --- optional -----------------------------------------------------------
FRONTEND_PORT=8080
